# Local-only by default. No images are sent to external services.
DATA_DIR=data
MODEL_BACKEND=demo
# MODEL_BACKEND=torch requires a locally trained weights file.
MODEL_WEIGHTS=weights/model.pt
# Foundation mode: MODEL_BACKEND=foundation; MODEL_WEIGHTS=weights/dinov2-lora
# Optional local, pinned DINOv2 snapshot; otherwise use the Hugging Face cache.
FOUNDATION_BASE_PATH=
MAX_UPLOAD_MB=256
# Optional DeepSeek / compatible tool-calling assistant. This file is a template.
# Copy to .env; the backend loads .env automatically. Never commit your real key.
# Enabling this sends aggregate metrics and the user's question to this endpoint.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
